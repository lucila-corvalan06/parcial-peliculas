<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Editar película — Cinema</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <link rel="stylesheet" href="/style.css">
</head>

<body>

  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">

    <div class="container">

      <a class="navbar-brand" href="/">
        Cinema
      </a>

      <button
        class="navbar-toggler"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#menu"
        aria-controls="menu"
        aria-expanded="false"
        aria-label="Abrir menú"
      >
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="menu">

        <ul class="navbar-nav ms-auto">

          <li class="nav-item">
            <a class="nav-link" href="/">
              Inicio
            </a>
          </li>

          <% secciones.forEach(function(s) { %>

            <li class="nav-item">
              <a class="nav-link" href="/secciones/<%= s.slug %>">
                <%= s.nombre %>
              </a>
            </li>

          <% }); %>

        </ul>

      </div>

    </div>

  </nav>


  <main class="container py-5">

    <div class="mb-5">

      <h1 class="titulo-principal">
        Editar película
      </h1>

      <p class="subtitulo">
        Modificá los datos de la película.
      </p>

    </div>


    <form action="/peliculas/<%= pelicula._id %>/editar" method="POST">

      <div class="mb-3">
        <label class="form-label">Título</label>
        <input
          type="text"
          class="form-control"
          name="titulo"
          value="<%= pelicula.titulo %>"
        >
      </div>


      <div class="mb-3">
        <label class="form-label">Sinopsis</label>
        <textarea
          class="form-control"
          name="sinopsis"
          rows="4"
        ><%= pelicula.sinopsis %></textarea>
      </div>


      <div class="mb-3">
        <label class="form-label">Trailer</label>
        <input
          type="url"
          class="form-control"
          name="trailer"
          value="<%= pelicula.trailer %>"
        >
      </div>


      <div class="mb-3">
        <label class="form-label">Poster</label>
        <input
          type="url"
          class="form-control"
          name="poster"
          value="<%= pelicula.poster %>"
        >
      </div>


      <div class="row">

        <div class="col-md-6 mb-3">
          <label class="form-label">Año</label>
          <input
            type="number"
            class="form-control"
            name="anio"
            value="<%= pelicula.anio %>"
          >
        </div>

        <div class="col-md-6 mb-3">
          <label class="form-label">Duración (minutos)</label>
          <input
            type="number"
            class="form-control"
            name="duracion"
            value="<%= pelicula.duracion %>"
          >
        </div>

      </div>


      <div class="mb-3">
        <label class="form-label">Géneros</label>
        <input
          type="text"
          class="form-control"
          name="generos"
          value="<%= pelicula.generos.join(', ') %>"
        >
      </div>


      <div class="mb-3">
        <label class="form-label">Sección</label>

        <select class="form-select" name="seccion">

          <% secciones.forEach(function(s) { %>

            <option
              value="<%= s.slug %>"
              <%= pelicula.seccion === s.slug ? 'selected' : '' %>
            >
              <%= s.nombre %>
            </option>

          <% }); %>

        </select>

      </div>


      <div class="mb-4">
        <label class="form-label">Director</label>

        <select class="form-select" name="directorId">

          <% directores.forEach(function(d) { %>

            <option
              value="<%= d._id %>"
              <%= pelicula.directorId === d._id.toString() ? 'selected' : '' %>
            >
              <%= d.nombre %>
            </option>

          <% }); %>

        </select>

      </div>


      <button type="submit" class="btn btn-trailer">
        Guardar cambios
      </button>

      <a href="/" class="btn btn-secondary">
        Cancelar
      </a>

    </form>

  </main>

</body>

</html>