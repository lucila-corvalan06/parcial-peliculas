<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= seccion.nombre %> — Películas</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
  <link rel="stylesheet" href="/style.css">
</head>

<body>
  <%- include("partials/navbar") %>

  <main class="container py-5">

    <div class="mb-5">

        <h1 class="titulo-principal">
            <%= seccion.nombre %>
        </h1>

        <p class="subtitulo">
            Películas de <%= seccion.nombre %>.
        </p>

    </div>

    
    <!-- Buscador y agregar película -->
    <div class="d-flex gap-3 mb-5">

        <form action="/" method="GET" class="flex-grow-1">

            <div class="input-group">

            <input
                type="text"
                name="titulo"
                class="form-control"
                placeholder="Buscar una película..."
            >

            <button class="btn btn-trailer" type="submit">
                Buscar
            </button>

            </div>

        </form>

        <a href="/peliculas/agregar" class="btn btn-trailer">
            + Agregar película
        </a>

    </div>

    <% if (peliculas.length === 0) { %>

      <div class="alert alert-info">
        Todavía no hay películas cargadas en esta sección.
      </div>

    <% } else { %>

      <div class="row g-4">

        <% peliculas.forEach(function(p) { %>

          <div class="col-md-6 col-lg-4">

            <div class="card h-100 shadow-sm">

              <img
                src="<%= p.poster %>"
                class="card-img-top"
                alt="<%= p.titulo %>"
                style="height: 400px; object-fit: cover;"
              >

                <div class="card-body d-flex flex-column">

                    <h5 class="card-title">
                    <%= p.titulo %>
                    </h5>

                    <p class="card-text">
                    <%= p.sinopsis %>
                    </p>

                    <p class="card-text mb-1">
                    <strong>Año:</strong> <%= p.anio %>
                    </p>

                    <p class="card-text mb-1">
                    <strong>Duración:</strong> <%= p.duracion %> min
                    </p>

                    <p class="card-text mb-3">
                    <strong>Director:</strong>
                    <%= p.directorNombre %>
                    </p>

                    <div class="d-flex gap-2 mb-2">

                        <a
                            href="/peliculas/<%= p._id %>/editar"
                            class="btn btn-secondary flex-fill"
                        >
                            Editar
                        </a>

                        <form
                            action="/peliculas/<%= p._id %>/eliminar"
                            method="POST"
                            class="flex-fill"
                        >
                            <button
                                type="submit"
                                class="btn btn-secondary w-100"
                                >
                                Eliminar
                            </button>
                        </form>    

                    </div>

                    <a
                    href="<%= p.trailer %>"
                    target="_blank"
                    class="btn btn-trailer mt-auto"
                    >
                        Ver trailer
                    </a>

                </div>

            </div>

          </div>

        <% }); %>

      </div>

    <% } %>

  </main>


  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
  ></script>

</body>

</html>
