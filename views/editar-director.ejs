<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Editar director — Cinema</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <link rel="stylesheet" href="/style.css">
</head>

<body>
  <%- include("partials/navbar") %>

  <main class="container py-5">

    <div class="mb-5">

      <h1 class="titulo-principal">
        Editar director
      </h1>

      <p class="subtitulo">
        Modificá los datos de <%= director.nombre %>.
      </p>

    </div>


    <div class="row">

      <div class="col-lg-8">

        <form action="/directores/<%= director._id %>/editar" method="POST">

          <div class="mb-3">

            <label for="nombre" class="form-label">
              Nombre
            </label>

            <input
              type="text"
              class="form-control"
              id="nombre"
              name="nombre"
              value="<%= director.nombre %>"
              required
            >

          </div>


          <div class="mb-3">

            <label for="foto" class="form-label">
              URL de la foto
            </label>

            <input
              type="url"
              class="form-control"
              id="foto"
              name="foto"
              value="<%= director.foto %>"
              required
            >

          </div>


          <div class="mb-4">

            <label for="descripcion" class="form-label">
              Descripción
            </label>

            <textarea
              class="form-control"
              id="descripcion"
              name="descripcion"
              rows="5"
              required
            ><%= director.descripcion %></textarea>

          </div>


          <div class="d-flex gap-2">

            <button
              type="submit"
              class="btn btn-trailer"
            >
              Guardar cambios
            </button>

            <a
              href="/directores"
              class="btn btn-secondary"
            >
              Cancelar
            </a>

          </div>

        </form>

      </div>

    </div>

  </main>

</body>

</html>