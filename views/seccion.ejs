<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title><%= seccion.nombre %> — Películas</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <div class="container py-5">
    <a href="/" class="btn btn-outline-secondary mb-4">&larr; Volver al menú</a>
    <h1 class="mb-4"><%= seccion.nombre %></h1>

    <% if (peliculas.length === 0) { %>
      <p class="text-muted">Todavía no hay películas cargadas en esta sección.</p>
    <% } %>

    <div class="row g-4">
      <% peliculas.forEach(function(p) { %>
        <div class="col-md-4">
          <div class="card h-100">
            <img src="<%= p.poster %>" class="card-img-top" alt="Poster de <%= p.titulo %>">
            <div class="card-body">
              <h5 class="card-title"><%= p.titulo %> (<%= p.anio %>)</h5>
              <p class="card-text"><%= p.sinopsis %></p>
              <p class="card-text"><small class="text-muted">Dirigida por <%= p.directorNombre %></small></p>
              <a href="<%= p.trailer %>" target="_blank" class="btn btn-sm btn-danger">Ver trailer</a>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</body>
</html>