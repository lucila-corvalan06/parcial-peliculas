<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= seccion.nombre %> — Películas</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
  <link rel="stylesheet" href="/style.css">
</head>

<body>

  <!-- Menú de navegación -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">

    <div class="container">

      <a class="navbar-brand" href="/">
         Cinema
      </a>

      <button
        class="navbar-toggler"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#menu"
        aria-controls="menu"
        aria-expanded="false"
        aria-label="Abrir menú"
      >
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="menu">

        <ul class="navbar-nav ms-auto">

            <li class="nav-item">
                <a class="nav-link" href="/">
                Inicio
                </a>
            </li>

            <% secciones.forEach(function(s) { %>

                <li class="nav-item">
                <a
                    class="nav-link <%= s.slug === seccion.slug ? 'active' : '' %>"
                    href="/secciones/<%= s.slug %>"
                >
                    <%= s.nombre %>
                </a>
                </li>

            <% }); %>

        </ul>

      </div>

    </div>

  </nav>


  <!-- Contenido -->
  <main class="container py-5">

    <div class="mb-5">

        <h1 class="titulo-principal">
            <%= seccion.nombre %>
        </h1>

        <p class="subtitulo">
            Películas de <%= seccion.nombre %>.
        </p>

    </div>

    
    <form action="/" method="GET" class="mb-5">
        <div class="input-group">

            <input
            type="text"
            name="titulo"
            class="form-control"
            placeholder="Buscar una película..."
            >

            <button class="btn btn-trailer" type="submit">
            Buscar
            </button>

        </div>
    </form>


    <% if (peliculas.length === 0) { %>

      <div class="alert alert-info">
        Todavía no hay películas cargadas en esta sección.
      </div>

    <% } else { %>

      <div class="row g-4">

        <% peliculas.forEach(function(p) { %>

          <div class="col-md-6 col-lg-4">

            <div class="card h-100 shadow-sm">

              <img
                src="<%= p.poster %>"
                class="card-img-top"
                alt="<%= p.titulo %>"
                style="height: 400px; object-fit: cover;"
              >

              <div class="card-body d-flex flex-column">

                <h5 class="card-title">
                  <%= p.titulo %>
                </h5>

                <p class="card-text">
                  <%= p.sinopsis %>
                </p>

                <p class="card-text mb-1">
                  <strong>Año:</strong> <%= p.anio %>
                </p>

                <p class="card-text mb-1">
                  <strong>Duración:</strong> <%= p.duracion %> min
                </p>

                <p class="card-text mb-3">
                  <strong>Director:</strong>
                  <%= p.directorNombre %>
                </p>

                <a
                  href="<%= p.trailer %>"
                  target="_blank"
                  class="btn btn-danger mt-auto"
                >
                  Ver trailer
                </a>

              </div>

            </div>

          </div>

        <% }); %>

      </div>

    <% } %>

  </main>


  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
  ></script>

</body>

</html>
