<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Catálogo de Películas</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <link rel="stylesheet" href="/style.css">
</head>

<body>

  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">

    <div class="container">

      <a class="navbar-brand" href="/">
        Cinema
      </a>

      <button
        class="navbar-toggler"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#menu"
        aria-controls="menu"
        aria-expanded="false"
        aria-label="Abrir menú"
      >
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="menu">

        <ul class="navbar-nav ms-auto">

          <li class="nav-item">
            <a class="nav-link active" href="/">
              Inicio
            </a>
          </li>

          <% secciones.forEach(function(s) { %>

            <li class="nav-item">
              <a class="nav-link" href="/secciones/<%= s.slug %>">
                <%= s.nombre %>
              </a>
            </li>

          <% }); %>

        </ul>

      </div>

    </div>

  </nav>


  <main class="container py-5">

    <div class="mb-5">

      <h1 class="titulo-principal">
        Descubrí tu próxima película
      </h1>

      <p class="subtitulo">
        Explorá nuestro catálogo y encontrá películas de todos los géneros.
      </p>

    </div>


    <div class="d-flex gap-3 mb-5">

      <form action="/" method="GET" class="flex-grow-1">

        <div class="input-group">

          <input
            type="text"
            name="titulo"
            class="form-control"
            placeholder="Buscar una película..."
            value="<%= busqueda %>"
          >

          <button class="btn btn-trailer" type="submit">
            Buscar
          </button>

        </div>

      </form>

      <a href="/peliculas/agregar" class="btn btn-trailer">
        + Agregar película
      </a>

    </div>


    <h2 class="seccion-titulo">
      Todas las películas
    </h2>


    <div class="row g-4">

      <% if (peliculas.length === 0) { %>

        <div class="col-12">

          <div class="alert alert-secondary">
            No se encontraron películas.
          </div>

        </div>

      <% } %>


      <% peliculas.forEach(function(p) { %>

        <div class="col-md-6 col-lg-4">

          <div class="card h-100 shadow-sm">

            <img
              src="<%= p.poster %>"
              class="card-img-top"
              alt="<%= p.titulo %>"
              style="height: 400px; object-fit: cover;"
            >

            <div class="card-body d-flex flex-column">

              <h5 class="card-title">
                <%= p.titulo %>
              </h5>

              <p class="card-text">
                <%= p.sinopsis %>
              </p>

              <p class="card-text mb-1">
                <strong>Año:</strong> <%= p.anio %>
              </p>

              <p class="card-text mb-1">
                <strong>Duración:</strong> <%= p.duracion %> min
              </p>

              <p class="card-text mb-3">
                <strong>Director:</strong> <%= p.directorNombre %>
              </p>

              <div class="d-flex gap-2 mb-2">

                <a
                  href="/peliculas/<%= p._id %>/editar"
                  class="btn btn-secondary flex-fill"
                >
                   Editar
                </a>

                <form
                action="/peliculas/<%= p._id %>/eliminar"
                method="POST"
                class="flex-fill"
                >
                    <button
                        type="submit"
                        class="btn btn-secondary w-100"
                    >
                         Eliminar
                    </button>
                </form>

              </div>

              <a
                href="<%= p.trailer %>"
                target="_blank"
                class="btn btn-trailer mt-auto"
              >
                Ver trailer
              </a>

            </div>

          </div>

        </div>

      <% }); %>

    </div>

  </main>


  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
  ></script>

</body>

</html>