<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Directores — Cinema</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <link rel="stylesheet" href="/style.css">
</head>

<body>
    <%- include("partials/navbar") %> 

  <main class="container py-5">

    <div class="mb-5">

      <h1 class="titulo-principal">
        Directores
      </h1>

      <p class="subtitulo">
        Conocé a los directores de nuestro catálogo.
      </p>

    </div>


    <div class="mb-5">

      <a href="/directores/agregar" class="btn btn-trailer">
        + Agregar director
      </a>

    </div>


    <% if (directores.length === 0) { %>

      <div class="alert alert-info">
        Todavía no hay directores cargados.
      </div>

    <% } else { %>

      <div class="row g-4">

        <% directores.forEach(function(d) { %>

          <div class="col-md-6 col-lg-4">

            <div class="card h-100 shadow-sm">

              <img
                src="<%= d.foto %>"
                class="card-img-top"
                alt="<%= d.nombre %>"
                style="height: 300px; object-fit: cover;"
              >

              <div class="card-body d-flex flex-column">

                <h5 class="card-title">
                  <%= d.nombre %>
                </h5>

                <p class="card-text">
                  <%= d.descripcion %>
                </p>

                <div class="d-flex gap-2 mt-auto">

                  <a
                    href="/directores/<%= d._id %>/editar"
                    class="btn btn-secondary flex-fill"
                  >
                    Editar
                  </a>

                  <form
                    action="/directores/<%= d._id %>/eliminar"
                    method="POST"
                    class="flex-fill"
                  >
                    <button
                      type="submit"
                      class="btn btn-secondary w-100"
                    >
                      Eliminar
                    </button>
                  </form>

                </div>

              </div>

            </div>

          </div>

        <% }); %>

      </div>

    <% } %>

  </main>

</body>

</html>